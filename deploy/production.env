# Template for /var/www/ezzini.ma/.env (root:www-data 640). provision.sh copies it once and generates APP_KEY.
APP_NAME="Ayoub Ezzini"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ezzini.ma

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=warning

CACHE_STORE=file

# Brevo: SMTP login and SMTP key from Brevo → SMTP & API
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=site@ezzini.ma
MAIL_FROM_NAME="ezzini.ma"

# Cloudflare Turnstile widget for ezzini.ma
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

CHROME_PATH=/usr/bin/google-chrome
